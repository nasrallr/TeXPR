{
  "name": "@texpr/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js --banner:js=\"import{createRequire}from\\\"node:module\\\";const require=createRequire(import.meta.url);\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "selftest": "node test/run-selftest.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1",
    "hono": "^4",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@texpr/shared": "*",
    "@types/node": "^22",
    "esbuild": "^0.25.0",
    "tsx": "^4",
    "typescript": "^5"
  }
}
